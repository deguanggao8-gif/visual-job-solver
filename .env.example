# Canonical origin used for <link rel="canonical">, Open Graph, sitemap.xml
# and robots.txt. REQUIRED for `npm run build`: a production export is refused
# without it so a guessed or localhost domain is never baked into shipped
# metadata. `npm run dev` does not need it (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
